export const config = { api: { bodyParser: { sizeLimit: '10mb' } } };

export default async function handler(req, res) {
  // Autorise CORS
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Méthode non autorisée' });

  try {
    const { image, mimeType } = req.body;
    if (!image) return res.status(400).json({ error: 'Image manquante' });

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': process.env.ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01',
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 500,
        messages: [{
          role: 'user',
          content: [
            {
              type: 'image',
              source: { type: 'base64', media_type: mimeType || 'image/jpeg', data: image },
            },
            {
              type: 'text',
              text: `Analyse cette image de produit alimentaire. Réponds UNIQUEMENT en JSON valide, sans markdown, sans explication :
{
  "name": "nom complet du produit",
  "gencod": "code-barres EAN 13 chiffres ou vide si non visible",
  "expiry": "date péremption au format YYYY-MM-DD ou vide si non visible",
  "rayon": "un parmi : Épicerie, Crémerie, Charcuterie, Boulangerie, Surgelés, Boissons, Hygiène, Confiserie, Traiteur"
}
Si tu ne vois pas une information, laisse la chaîne vide. Ne mets jamais null.`,
            },
          ],
        }],
      }),
    });

    if (!response.ok) {
      const err = await response.text();
      console.error('Anthropic error:', err);
      return res.status(500).json({ error: 'Erreur API analyse' });
    }

    const data = await response.json();
    const text = data.content?.[0]?.text || '{}';

    // Parse JSON robuste
    let parsed;
    try {
      parsed = JSON.parse(text.replace(/```json|```/g, '').trim());
    } catch {
      parsed = { name: '', gencod: '', expiry: '', rayon: 'Épicerie' };
    }

    return res.status(200).json({
      name:   parsed.name   || '',
      gencod: parsed.gencod || '',
      expiry: parsed.expiry || '',
      rayon:  parsed.rayon  || 'Épicerie',
    });

  } catch (err) {
    console.error('Handler error:', err);
    return res.status(500).json({ error: err.message });
  }
}
